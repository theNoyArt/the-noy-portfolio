# Copy this file to .env.local and fill in at least one key. .env.local is git-ignored.
# The chat tries providers in order (Gemini → Groq → Claude) and skips any without a key.

# Free: Google AI Studio → Get API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: which Gemini model (default: gemini-flash-latest, the current Flash model).
# GEMINI_MODEL=gemini-flash-latest

# Optional free backup: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional paid fallback: Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5

# Optional: change the order or leave providers out, e.g. "groq,gemini".
# CHAT_PROVIDERS=gemini,groq,claude
